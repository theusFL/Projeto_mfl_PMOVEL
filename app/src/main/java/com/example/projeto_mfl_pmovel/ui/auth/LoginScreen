import androidx.compose.foundation.layout.*
import androidx.compose.foundation.text.KeyboardOptions
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.text.input.KeyboardType
import androidx.compose.ui.text.input.PasswordVisualTransformation
import androidx.compose.ui.unit.dp

@Composable
fun LoginScreen() {
    var email by remember { mutableStateOf("") }
    var password by remember { mutableStateOf("") }

    Column(
        modifier = Modifier
            .fillMaxSize() // Preenche a tela inteira
            .padding(16.dp), // Adiciona um preenchimento nas bordas
        verticalArrangement = Arrangement.Center, // Centraliza tudo verticalmente
        horizontalAlignment = Alignment.CenterHorizontally // Centraliza tudo horizontalmente
    ) {

        Text(
            text = "Login",
            style = MaterialTheme.typography.headlineLarge // Título grande
        )

        Spacer(modifier = Modifier.height(32.dp)) // Espaço entre o título e o campo

        OutlinedTextField(
            value = email,
            onValueChange = { email = it }, // Atualiza o estado 'email'
            label = { Text("Email") },
            modifier = Modifier.fillMaxWidth() // Ocupa a largura máxima
        )

        Spacer(modifier = Modifier.height(16.dp)) // Espaço entre os campos

        OutlinedTextField(
            value = password,
            onValueChange = { password = it }, // Atualiza o estado 'password'
            label = { Text("Senha") },
            modifier = Modifier.fillMaxWidth(), // Ocupa a largura máxima
            visualTransformation = PasswordVisualTransformation(), // Esconde a senha (mostra ••••)
            keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Password) // Mostra o teclado de senha
        )

        Spacer(modifier = Modifier.height(24.dp)) // Espaço entre a senha e o botão

        // Botão de Entrar
        Button(
            onClick = {
                // não há validação.
            },
            modifier = Modifier.fillMaxWidth() // Ocupa a largura máxima
        ) {
            Text("Entrar")
        }
    }
}
